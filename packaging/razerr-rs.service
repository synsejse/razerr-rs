[Unit]
Description=razerr-rs OpenRazer device monitor
Documentation=https://github.com/openrazer/openrazer
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.razerr_rs.Service
ExecStart=@PREFIX@/bin/razerr-rs-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
